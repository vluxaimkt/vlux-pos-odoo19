<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.main_company" model="res.company" forcecreate="False">
        <field name="name">Braille International</field>
        <field name="logo"
               type="base64"
               file="braille_brand_theme/static/src/img/braille_logo.png"/>
        <field name="report_header">Arquitectura e ingeniería inclusiva</field>
        <field name="report_footer">Braille International</field>
    </record>

    <record id="base.partner_root" model="res.partner" forcecreate="False">
        <field name="name">Asistente Braille</field>
        <field name="image_1920"
               type="base64"
               file="braille_brand_theme/static/src/img/braille_mark.png"/>
    </record>
</odoo>
