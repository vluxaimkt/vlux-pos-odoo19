{
  "name": "vlux-pos-pwa",
  "private": true,
  "version": "0.1.0",
  "description": "VLUX POS: the register as an installable web app over the VLUX API v1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
