# VLUX EDGE - the single entry point of a VLUX POS cloud host.
# Rendered by `vlux-cloud host-init`. Do not edit in place.
#
# EDGE_MODE=public_acme        publishes 80/443 and terminates HTTPS with ACME.
# EDGE_MODE=cloudflare_tunnel  publishes NOTHING on the host; Cloudflare
#                              terminates TLS and cloudflared reaches this
#                              container over the private Docker network.

name: __PROJECT__

services:
  caddy:
    image: ${VLUX_CADDY_IMAGE:-caddy:2.10@sha256:c3d7ee5d2b11f9dc54f947f68a734c84e9c9666c92c88a7f30b9cba5da182adb}
    container_name: __EDGE_CONTAINER__
    restart: unless-stopped
__PORTS_BLOCK__    environment:
      VLUX_ACME_EMAIL: ${VLUX_ACME_EMAIL:-}
      VLUX_EDGE_MODE: __EDGE_MODE__
    volumes:
      - __EDGE_ROOT__/Caddyfile:/etc/caddy/Caddyfile:ro
      - __EDGE_ROOT__/tenants:/etc/caddy/tenants:ro
      - __EDGE_ROOT__/data:/data
      - __EDGE_ROOT__/config:/config
      - __EDGE_ROOT__/logs:/var/log/caddy
    networks:
      - edge
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O - http://127.0.0.1:8080/vlux/edge/health | grep -q ok"]
      interval: 20s
      timeout: 5s
      retries: 6
      start_period: 15s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"

networks:
  # Shared only between the edge, the tenant app containers and (in tunnel
  # mode) cloudflared. Tenant PostgreSQL containers are never attached to it.
  edge:
    name: __EDGE_NETWORK__
    external: true
