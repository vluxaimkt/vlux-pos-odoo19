[Unit]
Description=VLUX POS Application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=vlux-pos
Group=vlux-pos
WorkingDirectory=/opt/vlux/pos
Environment=VLUX_POS_ROOT=/opt/vlux/pos
Environment=VLUX_POS_CONFIG=/etc/vlux-pos
Environment=VLUX_POS_DATA=/var/lib/vlux-pos
Environment=VLUX_POS_BACKUPS=/var/backups/vlux-pos
Environment=VLUX_POS_LOGS=/var/log/vlux-pos
ExecStart=/opt/vlux/pos/venv/bin/python /opt/vlux/pos/odoo/odoo-bin -c /etc/vlux-pos/odoo.conf
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/etc/vlux-pos /var/lib/vlux-pos /var/backups/vlux-pos /var/log/vlux-pos

[Install]
WantedBy=multi-user.target
