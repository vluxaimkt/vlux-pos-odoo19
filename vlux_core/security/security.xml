<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_vlux">
        <field name="name">VLUX</field>
        <field name="sequence">25</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_vlux">
        <field name="name">VLUX</field>
        <field name="category_id" ref="module_category_vlux"/>
        <field name="sequence">25</field>
    </record>

    <record id="group_vlux_cashier" model="res.groups">
        <field name="name">VLUX Cashier</field>
        <field name="privilege_id" ref="res_groups_privilege_vlux"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="comment">Operación POS sin administración funcional.</field>
    </record>

    <record id="group_vlux_supervisor" model="res.groups">
        <field name="name">VLUX Supervisor</field>
        <field name="privilege_id" ref="res_groups_privilege_vlux"/>
        <field name="implied_ids" eval="[(4, ref('group_vlux_cashier')), (4, ref('point_of_sale.group_pos_manager'))]"/>
        <field name="comment">Supervisión de caja con granularidad nativa POS Manager.</field>
    </record>

    <record id="group_vlux_administrator" model="res.groups">
        <field name="name">VLUX Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_vlux"/>
        <field name="implied_ids" eval="[(4, ref('group_vlux_supervisor')), (4, ref('stock.group_stock_manager')), (4, ref('product.group_product_manager'))]"/>
        <field name="comment">Administración funcional POS/producto/inventario sin base.group_system.</field>
    </record>

    <record id="group_vlux_owner" model="res.groups">
        <field name="name">VLUX Owner</field>
        <field name="privilege_id" ref="res_groups_privilege_vlux"/>
        <field name="implied_ids" eval="[(4, ref('group_vlux_administrator'))]"/>
        <field name="comment">Máximo rol funcional del negocio. No es administrador técnico.</field>
    </record>

    <record id="group_vlux_inventory_operator" model="res.groups">
        <field name="name">VLUX Inventory Operator</field>
        <field name="privilege_id" ref="res_groups_privilege_vlux"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Operación de inventario sin acceso POS por rol VLUX.</field>
    </record>

    <record id="group_vlux_auditor" model="res.groups">
        <field name="name">VLUX Auditor</field>
        <field name="privilege_id" ref="res_groups_privilege_vlux"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Consulta read-only de información operativa autorizada.</field>
    </record>

    <record id="group_vlux_support" model="res.groups">
        <field name="name">VLUX Support</field>
        <field name="privilege_id" ref="res_groups_privilege_vlux"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Diagnóstico técnico VLUX no secreto, sin operación de negocio.</field>
    </record>
</odoo>
