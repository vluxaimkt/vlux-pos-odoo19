<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        The receipt already carries the company name, address, phone and VAT
        (the RFC in Mexico). VLUX adds the tax regime next to it and prints the
        legend at the very bottom, so a printed ticket is never mistaken for a
        tax document.
    -->
    <t t-name="vlux_core.ReceiptFiscalRegime" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('w-50')][hasclass('text-end')]//div[@t-if='company.vat']" position="after">
            <div t-if="company.vlux_fiscal_regime" class="vlux-receipt-regime">
                Régimen: <t t-out="company.vlux_fiscal_regime"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('footer-powered-by')]" position="before">
            <div t-if="company.vlux_receipt_legend" class="vlux-receipt-legend text-center pt-2" style="font-size: 75%;">
                <t t-out="company.vlux_receipt_legend"/>
            </div>
        </xpath>
        <!-- The ticket is the store's, not Odoo's. -->
        <xpath expr="//div[hasclass('footer-powered-by')]" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
        <!-- Odoo keeps the change as a negative amount; a customer reads "-190"
             as money owed. Print it the way the cashier hands it over. -->
        <xpath expr="//div[hasclass('receipt-change')]/span[hasclass('pos-receipt-right-align')]" position="attributes">
            <attribute name="t-out">formatCurrency(order.change &lt; 0 ? -order.change : order.change)</attribute>
        </xpath>
    </t>

    <!--
        A new store has no logo yet and Odoo prints its "Your logo" placeholder
        on every ticket. Without a real logo, print the store name instead; with
        one, print both (the name is how the customer finds the store again).
    -->
    <t t-name="vlux_core.ReceiptHeaderStoreName" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//img[hasclass('pos-receipt-logo')]" position="attributes">
            <attribute name="t-if">!order.company.uses_default_logo</attribute>
        </xpath>
        <xpath expr="//img[hasclass('pos-receipt-logo')]" position="after">
            <div class="vlux-receipt-store text-center fw-bold fs-5 pt-2" t-out="order.company.name"/>
        </xpath>
    </t>

    <!-- Same placeholder on the PIN screen: show the store name instead. -->
    <t t-name="vlux_core.LoginScreenStoreName" t-inherit="point_of_sale.LoginScreen" t-inherit-mode="extension">
        <xpath expr="//div[contains(@t-attf-class, 'screen-login-logo')]/img" position="attributes">
            <attribute name="t-if">!pos.company.uses_default_logo</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'screen-login-logo')]/img" position="after">
            <span t-else="" class="vlux-login-store fs-2 fw-bold" t-out="pos.company.name"/>
        </xpath>
    </t>
</templates>
