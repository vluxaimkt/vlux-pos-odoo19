<odoo>
    <record id="view_vlux_pac_provider_list" model="ir.ui.view">
        <field name="name">vlux.pac.provider.list</field>
        <field name="model">vlux.pac.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="provider_type"/>
                <field name="environment"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_vlux_pac_provider_form" model="ir.ui.view">
        <field name="name">vlux.pac.provider.form</field>
        <field name="model">vlux.pac.provider</field>
        <field name="arch" type="xml">
            <form string="Proveedor PAC">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group><group><field name="code"/><field name="provider_type"/></group><group><field name="environment"/><field name="active"/><field name="sequence"/></group></group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vlux_pac_provider" model="ir.actions.act_window">
        <field name="name">Proveedores PAC</field>
        <field name="res_model">vlux.pac.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
