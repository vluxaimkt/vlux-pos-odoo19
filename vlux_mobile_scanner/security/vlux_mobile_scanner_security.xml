<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vlux_mobile_pairing_company_rule" model="ir.rule">
        <field name="name">VLUX Mobile Scanner - pairing por compania</field>
        <field name="model_id" ref="model_vlux_mobile_scanner_pairing"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
    <record id="vlux_mobile_event_company_rule" model="ir.rule">
        <field name="name">VLUX Mobile Scanner - eventos por compania</field>
        <field name="model_id" ref="model_vlux_mobile_scanner_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
</odoo>
