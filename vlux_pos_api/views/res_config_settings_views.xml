        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="set_maximum_difference" position="after">
                <setting id="vlux_cashier_cash_out" string="Cajeros pueden sacar efectivo"
                         help="En la caja VLUX, los cajeros pueden registrar salidas de efectivo (con motivo, a su nombre). Las entradas siguen siendo del encargado.">
