<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Triggered on demand by vlux.catalog.import.action_import; the daily
         interval is only a safety net that resumes an interrupted import. -->
    <record id="ir_cron_vlux_catalog_import" model="ir.cron">
        <field name="name">VLUX: importar catálogo</field>
        <field name="model_id" ref="model_vlux_catalog_import"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
