<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="vlux_pos_credit.CreditDialog">
        <Dialog title="'Crédito de ' + props.partner.name" size="'md'">
            <div class="vlux-credit-dialog d-flex flex-column gap-3">
                <div class="d-flex justify-content-between fs-5">
                    <span>Debe hoy</span>
                    <strong class="vlux-credit-dialog-balance" t-out="balance"/>
                </div>
                <label class="d-flex align-items-center gap-2 fs-5" for="vluxCreditAllowed">
                    <input id="vluxCreditAllowed" type="checkbox" class="form-check-input mt-0" t-model="state.allowed"/>
                    Puede comprar a crédito
                </label>
                <div t-if="state.allowed">
                    <label class="form-label" for="vluxCreditLimit">Límite de crédito (lo máximo que puede deber)</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text">$</span>
                        <input id="vluxCreditLimit" class="form-control" type="text" inputmode="decimal" placeholder="1000" t-model="state.limit"/>
                    </div>
                    <small class="text-muted">0 o vacío = sin límite.</small>
                </div>
                <div t-if="state.error" class="alert alert-warning mb-0" t-esc="state.error"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary btn-lg vlux-credit-save" t-on-click="save" t-att-disabled="state.saving">Guardar</button>
                <button class="btn btn-secondary btn-lg" t-on-click="props.close">Cancelar</button>
            </t>
        </Dialog>
    </t>

</templates>
