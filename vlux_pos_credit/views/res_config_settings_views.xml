<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_vlux_pos_credit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.vlux.pos.credit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="set_maximum_difference" position="after">
                <setting id="vlux_credit_sellers" string="Venta a crédito (fiado)"
                         help="Quién puede vender a crédito en esta caja. Autorizar crédito y límites sigue siendo del encargado o el dueño.">
                    <field name="pos_vlux_credit_sellers" widget="radio"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
